{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":gitSignOff",
    ":semanticCommitsDisabled"
  ],
  "labels": ["dependencies"],
  "schedule": ["* 0-7 * * 1"],
  "timezone": "America/New_York",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": "at any time"
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/^kind-config\\.yaml$/",
      "/^demo-manifests/.+\\.yaml$/",
      "/^addons/.+\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "/^ghcr.io/stacklok/dockyard/"
      ],
      "groupName": "demo infrastructure dependencies"
    },
    {
      "matchPackageNames": [
        "/^ghcr.io/stacklok/",
        "!/^ghcr.io/stacklok/dockyard/",
        "/^ghcr.io/stackloklabs/",
        "/^stacklok//"
      ],
      "schedule": ["at any time"],
      "groupName": "ToolHive dependencies"
    },
    {
      "matchManagers": ["custom.regex", "kubernetes"],
      "matchPackageNames": [
        "!/^ghcr.io/stacklok/",
        "!/^ghcr.io/stackloklabs/",
        "!/^stacklok//"
      ],
      "groupName": "demo infrastructure dependencies"
    },
    {
      "matchFileNames": ["addons/backstage/**"],
      "groupName": "Backstage addon dependencies"
    },
    {
      "description": "Major bumps blocked: TypeScript 7 breaks fork-ts-checker-webpack-plugin, React 19 breaks @backstage/plugin-api-docs' bundled GraphiQL, Express 5 conflicts with express-promise-router's express@^4 peer requirement. Re-enable once the ecosystem catches up.",
      "matchFileNames": ["addons/backstage/**"],
      "matchPackageNames": [
        "typescript",
        "react",
        "react-dom",
        "react-router",
        "react-router-dom",
        "@types/react",
        "@types/react-dom",
        "@mui/material",
        "@mui/icons-material",
        "@testing-library/react",
        "@testing-library/dom",
        "@testing-library/jest-dom",
        "express",
        "@types/express",
        "supertest",
        "@types/supertest"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^versions\\.env$/", "/^bootstrap\\.sh$/", "/^addons/.+/deploy\\.sh$/"],
      "matchStrings": [
        "[A-Z_]+=\"(?<currentValue>[^\"]+)\"\\s*#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)(?:\\s+depName=(?<depName>[^\\s]+))?(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?"
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
